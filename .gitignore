# =============================================================================
# Gitignore for Dubbing Video Plus+
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Scratch & Temporary Testing Scripts
scratch/
tests/
test_*.py
*.tmp
*.bak
*.bat

# Workspace Media, Downloads & Temporary Cache
workspace/cache/*
!workspace/cache/.gitkeep
workspace/downloads/*
!workspace/downloads/.gitkeep
workspace/outputs/*
!workspace/outputs/.gitkeep
workspace/voices/*
!workspace/voices/.gitkeep
!workspace/voices/profiles.json

# Audio & Video Binaries
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.wav
*.mp3
*.aac
*.flac
*.m4a

# Model Weights & Checkpoints (Downloaded on-demand)
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.ckpt
checkpoints/
weights/
hf_cache/

# Local Logs & Secrets
*.log
logs/
.env
api_keys.json

# IDE / OS Specific Files
.idea/
.vscode/
*.swp
*.swo
*~
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
